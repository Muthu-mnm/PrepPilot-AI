# ==========================================
# PrepPilot AI — Comprehensive .gitignore
# Ensures sensitive credentials & artifacts are NEVER committed
# ==========================================

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
secrets.json

# Local Data Store & Databases
backend/data/
data/
*.sqlite
*.sqlite3
*.db
*.rdb

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/

# Testing & Linters
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Production Build Outputs
frontend/dist/
dist/
out/
.next/

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Candidate Personal Documents & Resumes
*.pdf
*.docx
*.doc
