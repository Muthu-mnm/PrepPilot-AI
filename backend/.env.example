# PrepPilot AI Backend Environment Configuration Template
PROJECT_NAME="PrepPilot AI"
API_V1_STR="/api"

# Database Configuration
# Provide MongoDB URI (e.g., Atlas). Leave blank to use local document store fallback in development.
MONGODB_URI=
DATABASE_NAME=preppilot_db

# AI Inference Engine Configuration
# For local Ollama: http://localhost:11434
# For remote/tunnel: https://<your-ngrok-or-remote-host>
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_TIMEOUT_SECONDS=45.0

# Security & Authentication
# Replace with a cryptographically secure random string in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
